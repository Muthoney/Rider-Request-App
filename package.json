{
  "name": "rider-requests",
  "version": "1.0.0",
  "private": true,
  "description": "Internal delivery coordination for requesters, dispatchers, managers and motorcycle riders.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.mjs",
    "dev": "node --no-warnings=ExperimentalWarning scripts/local.mjs dev",
    "provision": "node --no-warnings=ExperimentalWarning server/provision.mjs",
    "provision:sample": "node --no-warnings=ExperimentalWarning scripts/local.mjs provision --sample",
    "backup": "node --no-warnings=ExperimentalWarning server/backup.mjs",
    "test": "node --no-warnings=ExperimentalWarning --test tests/server.test.mjs tests/whatsapp.test.mjs tests/features.test.mjs",
    "provision:local": "node --no-warnings=ExperimentalWarning scripts/local.mjs provision",
    "backup:local": "node --no-warnings=ExperimentalWarning scripts/local.mjs backup"
  }
}

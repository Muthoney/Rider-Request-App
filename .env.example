# Copy to .env (never commit it). APP_ORIGIN must be the exact HTTPS origin users open.
APP_ORIGIN=https://riders.example.com
COOKIE_SECURE=true
TRUST_PROXY=1
# LOG_REQUESTS=1

# ---- Google Maps (live map, Kenya-only address search, road distances) ----
# Browser key: restrict to your APP_ORIGIN (HTTP referrer) and to the Maps JavaScript API.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID (Cloud console → Map management) for vector maps / advanced markers.
GOOGLE_MAPS_MAP_ID=
# Server key: restrict to your server IP and to Geocoding API + Routes API.
GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_ROUTES_TRAVEL_MODE=DRIVE

# ---- WhatsApp Cloud API (rider job notifications) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved utility template with 5 body variables (see deploy/OPERATIONS.md). Without it, plain
# text is sent, which WhatsApp only delivers inside a 24-hour conversation window.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Webhook: callback URL https://<APP_ORIGIN>/api/webhooks/whatsapp (statuses → SMS fallback on failure)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0

# ---- Africa's Talking SMS (fallback) ----
# Use AT_USERNAME=sandbox with a sandbox API key for testing.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ---- Password recovery email (SMTP). Falls back to WhatsApp, then SMS. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Rider Requests <no-reply@example.com>
# SMTP_SECURE=true   # implicit TLS (default for port 465)
# WHATSAPP_RESET_TEMPLATE=   # approved template with one variable: the reset link
